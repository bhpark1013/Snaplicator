# ── ports (host network) ─────────────────────────────────────────────
WEB_PORT=8080
BACKEND_PORT=8888

# ── btrfs pool ───────────────────────────────────────────────────────
# Provision with:  sudo python3 -m snaplicator_init "<publisher connstr>" --apply   (from cli/)
# Must be a btrfs path; mounted into the manager at the same path.
ROOT_DATA_DIR=/data/snaplicator
# subvolume name (under ROOT_DATA_DIR) holding the live replica's PGDATA
MAIN_DATA_DIR=main

# ── replica container (created by the manager, not by compose) ───────
CONTAINER_NAME=snaplicator_replica
NETWORK_NAME=snaplicator
HOST_PORT=5433
POSTGRES_IMAGE=postgres:17
POSTGRES_USER=snaplicator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# ── publisher (your primary database) ────────────────────────────────
PRIMARY_HOST=primary.example.com
PRIMARY_PORT=5432
PRIMARY_DB=mydb
PRIMARY_USER=replicator
PRIMARY_PASSWORD=change-me
PGSSLMODE=prefer

# ── replication naming ───────────────────────────────────────────────
PUBLICATION_NAME=snaplicator_publication
SUBSCRIPTION_NAME=snaplicator_subscription
DDL_SYNC_INTERVAL=30
# 0 replicates data but not schema changes — and then the first ALTER TABLE
# on a replicated table stops the apply worker, because the publisher starts
# sending a column the replica does not have.
DDL_APPLY_ENABLED=1
#REPLICATION_SCHEMAS=public

# ── FDW (optional; falls back to PRIMARY_* when unset) ───────────────
#FDW_USER=
#FDW_PASSWORD=
#FDW_HOST=
#FDW_PORT=
#FDW_DB=
